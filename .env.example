# agent-cache-web runtime config (Bun loads this automatically)
PORT=10901

# Database (Turso / libSQL) - local sqlite file or libsql://...
TURSO_DATABASE_URL=file:storage/agent-cache.db
TURSO_AUTH_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=cb662bf178fb76bf4995ab4d7dc7b347
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agent-cache
