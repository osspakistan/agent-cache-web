{
  "name": "agent-cache-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.tsx",
    "start": "bun run src/index.tsx",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint:fix && bun run typecheck && bun run lint"
  },
  "dependencies": {
    "evlog": "^2.28.0",
    "hono": "^4",
    "htmx.org": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
