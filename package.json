    "htmx.org": "4.0.0",
    "jsdom": "^30.0.1",
    "nanoid": "^6.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
